{
  "name": "samaanlink-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SamaanLink — customer & admin web UI for the FoodyExpress food ordering API",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:https": "next dev --experimental-https --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier -c -w .",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@tailwindcss/postcss": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.476.0",
    "motion": "^11.17.0",
    "next": "^15.3.6",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.7.15",
    "postcss": "8.4.49",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.33.5",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.4"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "eslint": "8.48.0",
    "eslint-config-next": "^15.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "5.7.2"
  },
  "overrides": {
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2"
  }
}
